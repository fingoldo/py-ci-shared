def tune_a(x):
    return sweep_backend_grid(x, repeats=3, equiv_rtol=1e-9, equiv_atol=1e-12)


def tune_b(x, eps):
    return sweep_backend_grid(x, repeats=3, equiv_rtol=max(1e-9, 8 * eps), equiv_atol=0.0)


def tune_c(x):
    return sweep_backend_grid(x, equiv_rtol=0.5)  # ktc-ok: rank binner vs percentile binner
