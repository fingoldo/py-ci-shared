import numpy as np


def score_all(baselines, y):
    """``y`` never changes across baselines but is recast every iteration."""
    for name in baselines:
        y_int = y.astype("int64")
        print(name, y_int)


def rank_all(baselines, y):
    """``y`` never changes across baselines but is re-sorted every iteration."""
    for name in baselines:
        print(name, np.argsort(y))


def asarray_all(baselines, z):
    """``z`` never changes but is re-wrapped through a numpy function every iteration."""
    for name in baselines:
        z_arr = np.asarray(z)
        print(name, z_arr)


def rank_method_all(baselines, w):
    """The method spelling of the heavy call."""
    for name in baselines:
        print(name, w.argsort())
