[project]
name = "seed"
version = "0"
dependencies = [
    "seedlib @ git+https://github.com/o/seedlib.git@0123456789abcdef0123456789abcdef01234567",
]

[project.optional-dependencies]
extra = ["seedextra @ git+https://github.com/o/seedextra.git@release-branch"]
seednoref = ["seednoref @ git+https://github.com/o/seednoref.git"]
seedshort = ["seedshort @ git+https://github.com/o/seedshort.git@abc1234"]

[tool.uv.sources]
seeduv = { git = "https://github.com/o/seeduv.git", branch = "dev-branch" }
