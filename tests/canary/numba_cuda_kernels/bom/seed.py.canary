import numpy as np
from numba import cuda


@cuda.jit(cache=True)
def unguarded(x, out):
    i = cuda.grid(1)
    out[i] = x[i] * 2.0


@cuda.jit
def divergent(x, out, n):
    tid = cuda.threadIdx.x
    sh = cuda.shared.array(128, dtype=np.float32)
    if tid >= n:
        return
    sh[tid] = x[tid]
    cuda.syncthreads()
    out[tid] = sh[tid]


@cuda.jit
def racy(x, total, n):
    tid = cuda.threadIdx.x
    for r in range(tid, n, 32):
        total[0] += x[r]


@cuda.jit
def mixed(x, out, n):
    i = cuda.grid(1)
    if i < n:
        out[i] = np.float32(x[i]) + np.float64(1.5)
