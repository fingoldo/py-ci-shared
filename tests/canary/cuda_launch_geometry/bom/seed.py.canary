import cupy as cp

THREADS = 192


def run(kernel, x, out, n):
    kernel((n // 256 + 1,), (256,), (x, out, n))
    kernel((n // THREADS + 1,), (THREADS,), (x, out, n))
    width = 128
    kernel((n // width + 1,), (width,), (x, out, n))
    kernel((n // 16 + 1, n // 16 + 1), (16, 16), (x, out, n))


async def run_async(kernel, x, out, n):
    kernel((n // 512 + 1,), (512,), (x, out, n))
