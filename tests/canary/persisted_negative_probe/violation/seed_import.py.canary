import json
from pathlib import Path

SEED_CACHE = Path("hw_fingerprint.json")


def seed_probe_by_import():
    try:
        import pynvml

        info = {"devices": pynvml.nvmlDeviceGetCount()}
    except (OSError, RuntimeError):
        info = {"name": "no-gpu"}
        SEED_CACHE.write_text(json.dumps(info))
    return info
