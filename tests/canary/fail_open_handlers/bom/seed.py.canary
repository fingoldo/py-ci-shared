def seed_check(v):
    try:
        return v > 0
    except Exception:
        return True


def seed_default(v):
    try:
        return int(v)
    except ValueError:
        return None


def seed_fallback(v, default):
    try:
        return int(v)
    except ValueError:
        return default


def seed_failed(v):
    try:
        return int(v)
    except ValueError:
        return failed()


def seed_empty(v):
    try:
        return int(v)
    except ValueError:
        return []

def seed_gate_skip(items):
    for item in items:
        try:
            int(item)
        except ValueError:
            continue


def seed_collect(items):
    kept = []
    for item in items:
        try:
            int(item)
        except ValueError:
            kept.append(item)
    return kept


def seed_quiet(v):
    try:
        out = int(v)
    except ValueError:
        out = 0
        logger.debug("bad value")
    return out
