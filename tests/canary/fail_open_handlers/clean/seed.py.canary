import logging

log = logging.getLogger(__name__)


def seed_check(v):
    try:
        return v > 0
    except Exception:
        log.warning("seed_check: comparison failed for %r", v)
        return False


def seed_default(v):
    try:
        return int(v)
    except ValueError:
        log.warning("seed_default: %r is not an int", v)
        return None


def seed_fallback(v, default):
    try:
        return int(v)
    except ValueError:
        log.warning("seed_fallback: %r is not an int", v)
        return default


def seed_failed(v):
    try:
        return int(v)
    except ValueError:
        log.warning("seed_failed: %r is not an int", v)
        return failed()


def seed_empty(v):
    try:
        return int(v)
    except ValueError:
        log.warning("seed_empty: %r is not an int", v)
        return []
