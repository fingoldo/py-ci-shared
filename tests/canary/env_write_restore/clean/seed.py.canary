import os
from unittest import mock

import pytest


def test_monkeypatch_restores(monkeypatch):
    monkeypatch.setenv("MLFRAME_FE_GPU_STRICT", "1")
    assert os.environ["MLFRAME_FE_GPU_STRICT"] == "1"


def test_patch_dict_restores():
    with mock.patch.dict(os.environ, {"MLFRAME_FE_GPU_STRICT": "1"}):
        assert os.environ["MLFRAME_FE_GPU_STRICT"] == "1"


def test_try_finally_restores():
    old = os.environ.get("MLFRAME_FE_GPU_STRICT")
    os.environ["MLFRAME_FE_GPU_STRICT"] = "1"
    try:
        assert os.environ["MLFRAME_FE_GPU_STRICT"] == "1"
    finally:
        if old is None:
            os.environ.pop("MLFRAME_FE_GPU_STRICT", None)
        else:
            os.environ["MLFRAME_FE_GPU_STRICT"] = old


@pytest.fixture
def strict_gpu():
    old = os.environ.get("MLFRAME_FE_GPU_STRICT")
    os.environ["MLFRAME_FE_GPU_STRICT"] = "1"
    yield
    if old is None:
        os.environ.pop("MLFRAME_FE_GPU_STRICT", None)
    else:
        os.environ["MLFRAME_FE_GPU_STRICT"] = old
