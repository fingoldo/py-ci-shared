version = 1
requires-python = ">=3.8"

[[package]]
name = "seed"
version = "0"
source = { editable = "." }

[package.metadata]
requires-dist = [
    { name = "flask" },
    { name = "pytest", marker = "extra == 'test'", specifier = ">=7" },
    { name = "requests", specifier = ">=3.0" },
]

[package.metadata.requires-dev]
dev = [{ name = "black" }]
