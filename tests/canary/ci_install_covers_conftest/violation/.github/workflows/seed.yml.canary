name: numba-coverage-nightly
on: [push]
jobs:
  numba-disabled-coverage:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - uses: astral-sh/setup-uv@v5
      - name: Install
        env:
          UV_SYSTEM_PYTHON: "1"
        run: |
          uv pip install -e ".[dev]"
      - name: Run the numba suites
        run: |
          pytest -p no:randomly \
            tests/
