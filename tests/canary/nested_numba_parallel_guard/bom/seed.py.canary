from concurrent.futures import ThreadPoolExecutor
import threading

from joblib import Parallel, delayed
from numba import njit, prange


@njit(parallel=True)
def kernel(x):
    total = 0.0
    for i in prange(len(x)):
        total += x[i]
    return total


def helper(x):
    return kernel(x)


def fan_executor(chunks):
    with ThreadPoolExecutor(4) as pool:
        return list(pool.map(helper, chunks))


def fan_thread(x):
    t = threading.Thread(target=helper, args=(x,))
    t.start()
    t.join()


def fan_joblib(chunks):
    return Parallel(n_jobs=4, backend="threading")(delayed(helper)(c) for c in chunks)
