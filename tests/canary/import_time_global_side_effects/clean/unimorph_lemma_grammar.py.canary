"""The fix: the same three statements run only when the file is executed as a script."""

import io
import logging
import sys
import warnings

logger = logging.getLogger(__name__)


def _configure_script_process() -> None:
    warnings.filterwarnings("ignore")
    logging.disable(logging.WARNING)
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")


def extract_verbecc(word, lang):
    return {}


def run_tests():
    return 0


if __name__ == "__main__":
    _configure_script_process()
    run_tests()
