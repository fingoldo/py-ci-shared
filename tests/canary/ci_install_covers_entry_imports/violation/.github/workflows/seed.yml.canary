name: seed-nightly
on:
  schedule:
    - cron: "0 3 * * *"
jobs:
  seed_nightly:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install
        run: pip install -e ".[dev]"
      - name: Run the nightly
        run: python -m seedpkg.nightly --dry-run
