server {
    listen ${PORT};
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'" always;
    add_header X-Content-Type-Options nosniff always;

    location / {
        try_files $uri /index.html;
    }

    location /robots.txt {
        add_header Cache-Control no-cache;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'" always;
        add_header X-Content-Type-Options nosniff always;
    }
}
