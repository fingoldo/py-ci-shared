class SeedModel:
    def __getstate__(self):
        state = self.__dict__.copy()
        state.pop("_lock", None)
        return state

    def run(self):
        self._seed_cache = {}
        self._lock = object()


class SeedPoolOwner:
    def start(self):
        from concurrent.futures import ThreadPoolExecutor

        self._seed_pool = ThreadPoolExecutor(2)
