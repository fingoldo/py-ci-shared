import numpy as np
from sklearn.model_selection import train_test_split


def seed_split(X, random_state=None):
    return train_test_split(X, random_state=42)


def seed_rng(n, seed=None):
    return np.random.default_rng(7).normal(size=n)


def seed_global(n, random_state=None):
    np.random.seed(3)
    return n
