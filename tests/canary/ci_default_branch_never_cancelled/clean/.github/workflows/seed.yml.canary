name: seed-ci
on:
  push:
    branches: [master]
  pull_request:
    branches: [master]
concurrency:
  group: seed-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
jobs:
  seed_job:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: pytest
